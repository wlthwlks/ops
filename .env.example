# —— Core ——
POSTGRES_URL=postgresql://user:password@host:5432/db
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/db
AIRTABLE_GET_DATA_TOKEN=
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CRON_SECRET=replace-with-long-random-secret
INTRODUCTIONS_MODE=read_only

# —— Unified introduction engine ——
# Resend webhook signing secret (Resend dashboard → Webhooks). Required for
# delivery event tracking (sent/delivered/bounced/…).
RESEND_WEBHOOK_SECRET=
# Visible sender for introduction emails.
INTRO_SENDER_EMAIL=WLTH WLKS <noreply@wlthwlks.com>
# Max number of groups processed per delivery-worker tick.
INTRO_DELIVERY_WORKER_BATCH_SIZE=20
# Pinecone namespace used for the semantic introduction vectors.
INTRO_SEMANTIC_NAMESPACE=intro_v2
# Fallback defaults for repeat-pair and member cooldown windows (days).
# Used when neither the matching profile nor city settings specify a value.
INTRO_PAIR_COOLDOWN_DAYS=60
INTRO_MEMBER_COOLDOWN_DAYS=14
# Set to "false" to disable the legacy recurring-introductions cron after
# the unified introduction engine takes over production.
LEGACY_RECURRING_INTROS_ENABLED=true

# —— Stripe ——
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Allowlist of Stripe membership Price IDs (price_…). Include BOTH the legacy
# (grandfathered) price(s) and the NEW current price(s) — existing members keep
# paying their legacy price, so invoices/entitlement must recognise both.
#   STRIPE_MEMBERSHIP_PRICE_IDS=price_legacy_xxx,price_new_yyy
# Preview: may use Memberstack commerce id only (prc_…). Checkout confirm then uses
#   owned-customer + proven paid subscription (memberstack_commerce_preview mode).
# Mixed is fine: price_xxx,prc_yyy
STRIPE_MEMBERSHIP_PRICE_IDS=price_xxxxxxxx
# REQUIRED for rejoin/reactivation: the NEW native Stripe price used whenever a
# new membership/subscription is created. Must NOT be a legacy/grandfathered price.
STRIPE_REACTIVATION_PRICE_ID=price_xxxxxxxx

# —— Klaviyo (membership-list sync at the end of the future-access-parity cron) ——
# Private API key from Klaviyo → Settings → API Keys.
KLAVIYO_PRIVATE_API_KEY=
# List ids for "WW Active members reliable" and the churned list
# (Klaviyo → Audience → Lists & Segments; the id is in the list URL).
KLAVIYO_ACTIVE_LIST_ID=
KLAVIYO_CHURNED_LIST_ID=
# Gate for the daily Klaviyo reconcile (default off until keys are provided).
KLAVIYO_SYNC_ENABLED=false
# Optional JSON:API revision override (default 2026-07-15).
# KLAVIYO_API_REVISION=2026-07-15

# —— Memberstack (forms) ——
NEXT_PUBLIC_MEMBERSTACK_PUBLIC_KEY=
MEMBERSTACK_SECRET_KEY=
MEMBERSTACK_WEBHOOK_SECRET=
# Memberstack commerce id for Airtable "Memberstack Plan ID"
MEMBERSTACK_MEMBERSHIP_PRICE_ID=prc_xxxxxxxx
# Custom field API keys from Memberstack dashboard (defaults are kebab-case)
# MEMBERSTACK_CF_FIRST_NAME=first-name
# MEMBERSTACK_CF_LAST_NAME=last-name
# MEMBERSTACK_CF_PHONE=phone-number
# MEMBERSTACK_CF_CITY=city
# MEMBERSTACK_CF_COUNTRY=country
# MEMBERSTACK_CF_POST_CODE=post-code

# —— Forms / webhooks feature flags (default OFF) ——
NEW_SIGNUP_WIDGET_ENABLED=false
NEW_UPDATE_DETAILS_WIDGET_ENABLED=false
NEW_MEMBERSTACK_WEBHOOKS_ENABLED=false
NEW_STRIPE_WEBHOOKS_ENABLED=false
NEW_FORM_ANALYTICS_ENABLED=false
MAKE_SHADOW_MODE=false
BILLING_ALERTS_TO_SLACK_ENABLED=false
RECONCILE_BILLING_CRON_ENABLED=false
SERVICE_ACCESS_POLICY_V2_ENABLED=false

# —— Widget / Webflow ——
WEBFLOW_ALLOWED_ORIGINS=https://example.com,https://*.webflow.io
WLTH_HOME_URL=https://example.com
# Able CDP Lead/Auth in signup widget (build-time). Also requires hostname women.wlthwlks.com.
# VITE_ABLE_TRACKING_ENABLED=true
WLTH_APPLY_PATH=/apply

# —— Rate limits (public form writes per IP) ——
FORMS_RATE_LIMIT_WRITE=30
FORMS_RATE_LIMIT_WRITE_WINDOW_MS=60000

# —— Incomplete onboarding cron ——
INCOMPLETE_ONBOARDING_STALE_HOURS=48
INCOMPLETE_ONBOARDING_MAX=100

# —— Dev-only Memberstack bypass (never production) ——
# ALLOW_MEMBERSTACK_TEST_AUTH=true

# —— Ops roles (Clerk user ids) ——
OPS_ADMIN_USER_IDS=
OPS_VIEWER_USER_IDS=
