# —— Core ——
POSTGRES_URL=postgresql://user:password@host:5432/db
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/db
AIRTABLE_GET_DATA_TOKEN=
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CRON_SECRET=replace-with-long-random-secret
INTRODUCTIONS_MODE=read_only

# —— Unified introduction engine ——
# Resend webhook signing secret (Resend dashboard → Webhooks). Required for
# delivery event tracking (sent/delivered/bounced/…).
RESEND_WEBHOOK_SECRET=
# Full-access (or emails:read) Resend API key used by the Delivery States tab
# to list sent emails. Optional — falls back to RESEND_API_KEY, which may be
# a send-only restricted key that cannot list emails.
RESEND_READ_API_KEY=
# Visible sender for introduction emails.
INTRO_SENDER_EMAIL=WLTH WLKS <noreply@wlthwlks.com>
# Max number of groups processed per delivery-worker tick.
INTRO_DELIVERY_WORKER_BATCH_SIZE=20
# Pinecone namespace used for the semantic introduction vectors.
INTRO_SEMANTIC_NAMESPACE=intro_v2
# Fallback defaults for repeat-pair and member cooldown windows (days).
# Used when neither the matching profile nor city settings specify a value.
INTRO_PAIR_COOLDOWN_DAYS=60
INTRO_MEMBER_COOLDOWN_DAYS=14
# Set to "false" to disable the legacy recurring-introductions cron after
# the unified introduction engine takes over production.
LEGACY_RECURRING_INTROS_ENABLED=true

# —— Stripe ——
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# —— Billing Catalog (REQUIRED for multiple prices / offers) ——
# Single JSON env var describing every membership price and promo offer.
# Set per environment (Test/Preview/Production) — stable `priceKey`s are shared,
# while prc_/price_ ids differ per env. When unset, the legacy vars below are
# used as a migration fallback (single-price behavior).
# Fields: priceKey (stable), tierKey (standard|basic|gold|platinum|…),
# cadence (monthly|quarterly|yearly|custom), intervalCount, stripePriceId,
# memberstackPriceId, sellable, legacy (grandfathered retention),
# eligibleForSignup, eligibleForReactivation, label, description,
# trialDays, amountUsd.
# Offers: offerKey, code (normalized uppercase), targetPriceKey, enabled,
# startDate, endDate, newCustomersOnly, redemptionLimits.
# BILLING_CATALOG_JSON={"version":1,"defaultTierKey":"standard","defaultPriceKey":"standard_quarterly_default","prices":[{"priceKey":"standard_quarterly_default","tierKey":"standard","cadence":"quarterly","intervalCount":3,"stripePriceId":"price_xxx","memberstackPriceId":"prc_yyy","sellable":true,"legacy":false,"eligibleForSignup":true,"eligibleForReactivation":true,"label":"$87 every 3 months","amountUsd":87},{"priceKey":"standard_quarterly_founders45","tierKey":"standard","cadence":"quarterly","intervalCount":3,"stripePriceId":"price_f45_xxx","memberstackPriceId":"prc_f45_yyy","sellable":true,"legacy":false,"eligibleForSignup":true,"eligibleForReactivation":false,"label":"$45 every 3 months","description":"3 months free, then $45 every 3 months indefinitely","trialDays":90,"amountUsd":45},{"priceKey":"standard_legacy_grandfathered","tierKey":"standard","cadence":"quarterly","stripePriceId":"price_legacy_xxx","memberstackPriceId":"prc_legacy_yyy","sellable":false,"legacy":true,"eligibleForSignup":false,"eligibleForReactivation":false}],"offers":[{"offerKey":"founders45","code":"FOUNDERS45","targetPriceKey":"standard_quarterly_founders45","enabled":true,"startDate":null,"endDate":null,"newCustomersOnly":true,"redemptionLimits":null}]}

# —— Legacy env vars (migration fallback; superseded by BILLING_CATALOG_JSON) ——
# Allowlist of Stripe membership Price IDs (price_…). Include BOTH the legacy
# (grandfathered) price(s) and the NEW current price(s) — existing members keep
# paying their legacy price, so invoices/entitlement must recognise both.
#   STRIPE_MEMBERSHIP_PRICE_IDS=price_legacy_xxx,price_new_yyy
# Preview: may use Memberstack commerce id only (prc_…). Checkout confirm then uses
#   owned-customer + proven paid subscription (memberstack_commerce_preview mode).
# Mixed is fine: price_xxx,prc_yyy
STRIPE_MEMBERSHIP_PRICE_IDS=price_xxxxxxxx
# REQUIRED for rejoin/reactivation: the NEW native Stripe price used whenever a
# new membership/subscription is created. Must NOT be a legacy/grandfathered price.
STRIPE_REACTIVATION_PRICE_ID=price_xxxxxxxx

# —— Klaviyo (membership-list sync at the end of the future-access-parity cron) ——
# Private API key from Klaviyo → Settings → API Keys.
KLAVIYO_PRIVATE_API_KEY=
# List ids for "WW Active members reliable" and the churned list
# (Klaviyo → Audience → Lists & Segments; the id is in the list URL).
KLAVIYO_ACTIVE_LIST_ID=
KLAVIYO_CHURNED_LIST_ID=
# Gate for the daily Klaviyo reconcile (default off until keys are provided).
KLAVIYO_SYNC_ENABLED=false
# Optional JSON:API revision override (default 2026-07-15).
# KLAVIYO_API_REVISION=2026-07-15

# —— Memberstack (forms) ——
NEXT_PUBLIC_MEMBERSTACK_PUBLIC_KEY=
MEMBERSTACK_SECRET_KEY=
MEMBERSTACK_WEBHOOK_SECRET=
# Memberstack commerce id for Airtable "Memberstack Plan ID"
# (legacy fallback; prefer the catalog default price's memberstackPriceId)
MEMBERSTACK_MEMBERSHIP_PRICE_ID=prc_xxxxxxxx
# Custom field API keys from Memberstack dashboard (defaults are kebab-case)
# MEMBERSTACK_CF_FIRST_NAME=first-name
# MEMBERSTACK_CF_LAST_NAME=last-name
# MEMBERSTACK_CF_PHONE=phone-number
# MEMBERSTACK_CF_CITY=city
# MEMBERSTACK_CF_COUNTRY=country
# MEMBERSTACK_CF_POST_CODE=post-code

# —— Forms / webhooks feature flags (default OFF) ——
NEW_SIGNUP_WIDGET_ENABLED=false
NEW_UPDATE_DETAILS_WIDGET_ENABLED=false
NEW_MEMBERSTACK_WEBHOOKS_ENABLED=false
NEW_STRIPE_WEBHOOKS_ENABLED=false
NEW_FORM_ANALYTICS_ENABLED=false
MAKE_SHADOW_MODE=false
BILLING_ALERTS_TO_SLACK_ENABLED=false
RECONCILE_BILLING_CRON_ENABLED=false
INTRO_PINECONE_CLEANUP_CRON_ENABLED=false
SERVICE_ACCESS_POLICY_V2_ENABLED=false

# —— Slack community: customer workspace (wlth-wlks.slack.com) ——
# Bot that manages community access: identity linking, channel membership,
# removal and invites. Scopes: users:read, users:read.email, channels:read,
# groups:read, groups:write (private city channels), channels:manage (#introductions).
SLACK_BOT_TOKEN=
# Invite links for new members (fallback of each other).
SLACK_WORKSPACE_INVITE_URL=
SLACK_JOIN_URL=
# Workspace subdomain used for channel deep links in invite emails.
SLACK_WORKSPACE_URL=https://wlth-wlks.slack.com
# Community-wide channel (#introductions, renamed from all-wlth-wlks).
SLACK_ALL_MEMBERS_CHANNEL_ID=
SLACK_ALL_MEMBERS_CHANNEL_NAME=introductions
# Invite cooldown in days (Resend emails).
SLACK_OUTREACH_COOLDOWN_DAYS=7
# Optional: Enterprise Grid admin token (admin.users:write) for workspace
# invite + deactivation via API. Not required for channel kick/invite.
SLACK_ADMIN_USER_TOKEN=

# —— Slack notification: new paid signup members (internal company workspace) ——
# Dedicated bot token for the internal wlthwlks.slack.com workspace (chat:write scope).
# NOT the customer community workspace (that is SLACK_BOT_TOKEN on wlth-wlks.slack.com).
# The bot must be invited into the channel below.
SLACK_WW_BOT_TOKEN=
# Channel (name or id) for "New 2.0 WW Member [Paid]" notifications.
SLACK_WW_NEW_MEMBERS_CHANNEL=ww-new-members

# —— Widget / Webflow ——
WEBFLOW_ALLOWED_ORIGINS=https://example.com,https://*.webflow.io
WLTH_HOME_URL=https://example.com
# Able CDP Lead/Auth in signup widget (build-time). Also requires hostname women.wlthwlks.com.
# VITE_ABLE_TRACKING_ENABLED=true
WLTH_APPLY_PATH=/apply

# —— Rate limits (public form writes per IP) ——
FORMS_RATE_LIMIT_WRITE=30
FORMS_RATE_LIMIT_WRITE_WINDOW_MS=60000

# —— Incomplete onboarding cron ——
INCOMPLETE_ONBOARDING_STALE_HOURS=48
INCOMPLETE_ONBOARDING_MAX=100

# —— Dev-only Memberstack bypass (never production) ——
# ALLOW_MEMBERSTACK_TEST_AUTH=true

# —— Ops roles (Clerk user ids) ——
OPS_ADMIN_USER_IDS=
OPS_VIEWER_USER_IDS=
